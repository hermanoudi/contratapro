# ===================================
# VARIÁVEIS DE AMBIENTE PARA RAILWAY
# ===================================
# Cole estas variáveis no Railway (aba Variables → Raw Editor)
# Substitua os valores de exemplo pelos seus valores reais

# ===================================
# BANCO DE DADOS
# ===================================
# O Railway cria automaticamente a variável DATABASE_URL quando você adiciona PostgreSQL
# Ela virá no formato: postgresql://...
# O código já converte automaticamente para postgresql+asyncpg://
# Então você NÃO precisa adicionar DATABASE_URL manualmente!

# ===================================
# JWT (Autenticação)
# ===================================
# IMPORTANTE: Gere um secret forte! Use um gerador de senhas ou:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# JWT_SECRET_KEY continua funcionando (nome legado). O nome canônico agora
# é SECRET_KEY — não é preciso migrar imediatamente, mas prefira SECRET_KEY
# em configurações novas. A aplicação agora recusa subir se nenhum dos dois
# estiver definido, ou se o valor for um placeholder conhecido (ver
# backend/app/config.py) — confirme no Railway que esta variável está
# definida com um valor real, não com o texto de exemplo abaixo.
JWT_SECRET_KEY=SUBSTITUA-POR-UM-SECRET-FORTE-MINIMO-32-CARACTERES
JWT_ALGORITHM=HS256

# ===================================
# CLOUDINARY (Upload de Imagens)
# ===================================
# Pegue suas credenciais em: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret
UPLOAD_STORAGE=cloudinary

# ===================================
# MERCADO PAGO (Pagamentos)
# ===================================
# PRODUÇÃO - Pegue em: https://www.mercadopago.com.br/developers/panel/credentials
# IMPORTANTE: Use credenciais de PRODUÇÃO, não de teste!
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-de-producao

# Segredo de assinatura do webhook. Configure o MESMO valor aqui e no painel
# do Mercado Pago (Suas integrações > sua aplicação > Webhooks > Chave
# secreta). AÇÃO NECESSÁRIA NO DEPLOY: sem esta variável, o backend passa a
# rejeitar TODOS os webhooks com 401 e assinaturas pagas param de ser
# ativadas automaticamente — configure antes ou junto do deploy desta
# mudança, não depois.
MERCADOPAGO_WEBHOOK_SECRET=SUBSTITUA-PELO-SEGREDO-CONFIGURADO-NO-PAINEL-DO-MERCADO-PAGO

# ===================================
# URLs
# ===================================
# URL do frontend (será usada para CORS e redirecionamentos)
FRONTEND_URL=https://contratapro.vercel.app

# URL do backend (opcional, Railway define automaticamente)
# BACKEND_URL será definido automaticamente pelo Railway

# ===================================
# CONFIGURAÇÕES DE ASSINATURA
# ===================================
SUBSCRIPTION_AMOUNT=50.00
SUBSCRIPTION_FREQUENCY=1
SUBSCRIPTION_FREQUENCY_TYPE=months

# ===================================
# UPLOAD DE IMAGENS
# ===================================
MAX_UPLOAD_SIZE=5242880
# ALLOWED_EXTENSIONS não precisa ser definido (usa padrão do código)

# ===================================
# NOTAS IMPORTANTES
# ===================================
# 1. NÃO adicione DATABASE_URL - o Railway cria automaticamente
# 2. GERE um JWT_SECRET_KEY forte - NUNCA use o padrão
# 3. Use credenciais de PRODUÇÃO do Mercado Pago
# 4. Depois de adicionar as variáveis, o Railway irá redesenhar automaticamente
