# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Para desenvolvimento local: postgresql+asyncpg://user:password@localhost/faz_de_tudo
# Para produção (Railway): usar a DATABASE_URL fornecida automaticamente
DATABASE_URL=postgresql+asyncpg://user:password@db/faz_de_tudo

# ===========================================
# JWT (Autenticação)
# ===========================================
# IMPORTANTE: Gere uma chave secreta forte, única, e NUNCA a compartilhe.
# Ela também assina os antigos endpoints /admin/setup/* (Fase 1.2 do plano
# de melhorias os removeu/protegeu, mas não reutilize esta chave para nada
# além de JWT).
# Execute: python3 generate_jwt_secret.py
# Ou: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Nome canônico: SECRET_KEY. O nome antigo JWT_SECRET_KEY continua
# funcionando (compatibilidade de transição — ver backend/app/config.py),
# mas prefira SECRET_KEY em configurações novas.
#
# A aplicação recusa subir (falha no import de app.config) se esta variável
# estiver ausente, vazia, ou for um dos literais de exemplo que já
# circularam neste arquivo/no código — nunca use o valor abaixo como está.
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# MERCADO PAGO (Pagamentos)
# ===========================================
# Obtenha suas credenciais em: https://www.mercadopago.com.br/developers/panel/credentials
# Use credenciais de TESTE para desenvolvimento
# Use credenciais de PRODUÇÃO para deploy final
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-access-token-here
MERCADOPAGO_PUBLIC_KEY=APP_USR-your-public-key-here

# Segredo de assinatura do webhook (Fase 1.3 do plano de melhorias).
# Configure o MESMO valor aqui e no painel do Mercado Pago
# (Suas integrações > sua aplicação > Webhooks > Chave secreta).
# SEM ESTA VARIÁVEL, TODO WEBHOOK RECEBIDO É REJEITADO COM 401 — o que
# significa que assinaturas pagas param de ser ativadas automaticamente.
MERCADOPAGO_WEBHOOK_SECRET=

# ===========================================
# URLs DA APLICAÇÃO
# ===========================================
# Para desenvolvimento local
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Para produção (Railway): atualizar com URLs reais
# FRONTEND_URL=https://seu-app.railway.app
# BACKEND_URL=https://seu-backend.railway.app

# ===========================================
# PLANO DE ASSINATURA
# ===========================================
SUBSCRIPTION_AMOUNT=50.00
SUBSCRIPTION_FREQUENCY=1
SUBSCRIPTION_FREQUENCY_TYPE=months

# ===========================================
# UPLOAD DE IMAGENS
# ===========================================
# Opções: "local" para desenvolvimento ou "cloudinary" para produção
# DESENVOLVIMENTO: use "local"
# PRODUÇÃO: use "cloudinary"
UPLOAD_STORAGE=local

# Cloudinary (necessário apenas para produção)
# Obtenha suas credenciais em: https://cloudinary.com/console
# Deixe em branco se usar UPLOAD_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Configurações de Upload (opcional - já tem valores padrão)
# MAX_UPLOAD_SIZE=5242880
# ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
